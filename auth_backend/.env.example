DEBUG=False
SECRET_KEY=replace-with-long-random-django-secret
SERVER_BASE_URL=https://stepmates.onrender.com
ALLOWED_HOSTS=stepmates.onrender.com
CSRF_TRUSTED_ORIGINS=https://stepmates.onrender.com

DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_SSL_REQUIRE=True

EMAIL_HOST=smtp.yandex.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DISABLE_EMAIL=False

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
